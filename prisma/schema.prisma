// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgeStage {
  Infant
  Toddler
  Child
  Teen
  Adult
  Elder
}

enum MediaType {
  Audio
  Photo
  Structure3D
  Mocap
}

enum MediaOwner {
  Lot
  Neighborhood
  Story
  Character
}

model Character {
  id           Int      @id @default(autoincrement())
  name         String
  backstory    String?
  currentAge   AgeStage @default(Adult)
  timeTraveler Boolean  @default(false)
  createdAt    DateTime @default(now())

  story         Event[]
  relationships Relationship[] @relation("CharacterRelationships")
  relatedTo     Relationship[] @relation("RelatedCharacters")
}


model Relationship {
  id          Int      @id @default(autoincrement())
  type        String
  strength    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characterId Int
  character   Character @relation("CharacterRelationships", fields: [characterId], references: [id])
  relatedToId Int
  relatedTo   Character @relation("RelatedCharacters", fields: [relatedToId], references: [id])
}

model Lot {
  id                Int           @id @default(autoincrement())
  name              String
  dateFounded       DateTime?
  architectDesigner String?
  publicSpace       Boolean       @default(true)
  createdAt         DateTime      @default(now())

  neighborhoodId    Int?
  neighborhood      Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  events            Event[]
}

model Neighborhood {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())

  lots Lot[]
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  datetime    DateTime
  description String
  major       Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lotId  Int?
  lot    Lot?  @relation(fields: [lotId], references: [id])
  characterId Int?
  character   Character? @relation(fields: [characterId], references: [id])

  stories     StoryEvent[]
}

model Story {
  id        Int      @id @default(autoincrement())
  content   String
  layer     Int      @default(1)
  createdAt DateTime @default(now())

  events     StoryEvent[]
}

model StoryEvent {
  storyId Int
  eventId Int
  story   Story @relation(fields: [storyId], references: [id])
  event   Event @relation(fields: [eventId], references: [id])

  @@id([storyId, eventId])
}

model Media {
  id        Int       @id @default(autoincrement())
  url       String
  type      MediaType
  createdAt DateTime  @default(now())

  attachments MediaAttachment[]
}

model MediaAttachment {
  id         Int        @id @default(autoincrement())
  mediaId    Int
  media      Media      @relation(fields: [mediaId], references: [id])
  mediaOwner MediaOwner
  ownerId   Int

  @@unique([mediaId, mediaOwner, ownerId])
}
